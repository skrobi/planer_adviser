  "mapping_notes": {
    "engine": "Każde path mapuje 1:1 na adventure_knowledge.json → data_dictionary.paths. Wizard UI zapisuje answers[path]=value.",
    "planning": "Po wizardzie uruchom modele stage_demand → effort_decay → hydration_carry_plan / nutrition_pack_plan, a następnie reguły ekspertów.",
    "gel_cho_g": "Wymagane praktycznie przy preference gels/mixed — bez tego default 25 g i used_default_gel_cho=true.",
    "pack_semantics": "Tryb żywienia kontroluje wyłącznie user.planned_pack_declared. false/brak → user.planned_pack=null i tryb buffer. true → utwórz obiekt planned_pack; nieuzupełnione liczniki potraktuj jako 0.",
    "time_margin": "Time margin is only a complete estimate when event limit, stage duration, planned stops and planned sleep are known. Missing stop/sleep values must be surfaced as partial."
  },
  "defaults_short": {
    "description": {
      "pl": "Wartości operacyjne uzupełniane automatycznie. Użytkownik nie musi znać parametrów fizjologicznych ani szczegółów produktów. Każdy default musi być oznaczony jako założenie, a nie pomiar.",
      "en": "Operational values filled automatically. Users do not need specialist physiology or product data. Every default must be marked as an assumption, not a measurement."
    },
    "values": {
      "user.body_mass_kg": null,
      "user.planned_sleep_h_per_24": 7,
      "user.sweat_rate_l_per_h": null,
      "user.gel_cho_g": 25,
      "user.bar_cho_g": 30,
      "user.banana_cho_g": 27,
      "user.gi_tolerance_high_cho": "unknown",
      "user.bikepacking_experience": false,
      "route.unpaved_fraction": 0.3,
      "environment.temperature_c": 20,
      "logistics.verified_water_pois_km": [],
      "logistics.verified_food_pois_km": [],
      "user.luggage_mass_kg": null,
      "event.has_time_limit": false,
      "event.time_limit_hours": null,
      "event.intermediate_controls_timed": false,
      "ride.estimated_time_hours": null,
      "user.planned_pack": null,
      "user.planned_pack_declared": false,
      "user.nutrition_preference": "mixed"
    },
    "notes": {
      "user.gel_cho_g": "25 g only if user skipped gel question; mark plan.nutrition.used_default_gel_cho=true",
      "user.sweat_rate_l_per_h": "null → hydration model uses 0.4–0.8 L/h operational default",
      "logistics.verified_*_pois_km": "empty → no credit for resupply until user adds verified POIs",
      "route.unpaved_fraction": "0.3 is a generic mixed-route estimate only when surface composition is unavailable; mark estimated and lower confidence. Prefer GPX/route surface data.",
      "nutrition_unknown": "If pack is not declared, use buffer mode and state that the plan is indicative. Do not claim the user's actual carried food is insufficient.",
      "user_planned_pack_declared": "false selects buffer mode. The basic wizard does not ask for a detailed food inventory; it is optional in advanced mode.",
      "user.luggage_mass_kg": "null → luggage contribution is omitted and input completeness is marked partial; never assume a generic 10 kg as the rider's actual luggage.",
      "user.nutrition_preference": "mixed is a neutral planning preference, not a measured or binding diet choice.",
      "environment.temperature_c": "20°C is a neutral scenario assumption only when no forecast is available; it must not be presented as the event forecast or as a personalized heat assessment.",
      "logistics.verified_water_pois_km": "No manual list is required; Ridemore POI adapter supplies records. Empty means no verified POI was passed, not that none exists.",
      "logistics.verified_food_pois_km": "No manual list is required; Ridemore POI adapter supplies records. Empty means no verified POI was passed, not that none exists."
    }
  },
  "ui_logic": {
    "on_mode_short": [
      "Show only questions where modes contains 'short'",
      "After submit, merge defaults_short.values for any missing path",
      "Set wizard.used_defaults = list of paths filled from defaults"
    ],
    "on_mode_advanced": [
      "Show all questions respecting their show_if",
      "Do not apply defaults_short unless field explicitly empty and optional"
    ]
  },
  "i18n": {
    "default_locale": "pl",
    "supported_locales": [
      "pl",
      "en"
    ],
    "resolution": "label[locale] ?? label.en ?? label.pl"
  },
