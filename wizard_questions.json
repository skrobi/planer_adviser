{
  "meta": {
    "id": "ridemore_trip_wizard",
    "version": "0.9.0",
    "kb_version_target": "0.9.5-wizard-ux",
    "language_default": "pl",
    "description": "Wizard progresywny: krótki tryb domyślny, pytania tylko dla brakujących danych, techniczne pomiary odłożone do Advanced Trainer. Dane z profilu, historii Ridemore i GPX są używane automatycznie.",
    "output_context_root": "wizard_answers → nested paths used by rule engine",
    "updated": "2026-11-05",
    "default_mode": "short",
    "ux_principles": [
      "Short mode is the default and should contain no specialist physiology or product-composition questions.",
      "Prefill from rider profile, activity history, planner route analysis and POI adapter before rendering questions.",
      "Ask only when a value is missing and materially changes the requested analysis.",
      "Allow skipping optional values; missing values must remain unknown and must not be converted to zero.",
      "Technical measurements such as sweat rate, sodium concentration, FTP, VO2max and body mass belong to a future Advanced Trainer, not the trip wizard.",
      "The trip wizard should normally present no more than 6-8 unanswered questions; conditional questions appear only when relevant.",
      "Do not ask users to manually list POIs that already exist in Ridemore."
    ],
    "deferred_to_advanced_trainer": [
      "user.sweat_rate_l_per_h",
      "user.body_mass_kg",
      "user.gi_tolerance_high_cho",
      "user.ftp_w",
      "user.vo2max_ml_kg_min",
      "user.sodium_loss_mg_l"
    ],
    "prefill_sources": [
      "rider_profile.declared",
      "rider_profile.observed",
      "rider_profile.measured",
      "rider_profile.equipment",
      "route_analysis",
      "poi_adapter",
      "event_data"
    ],
    "question_policy": {
      "required": "Only required when the requested calculation cannot proceed without the value and no trusted source or default is available.",
      "conditional": "Use ask_if_missing and show_if / required_when_shown; never ask again for an already supplied value.",
      "manual_poi_entry": "disabled",
      "unknown_values": "Preserve null/unknown and report resulting uncertainty.",
      "ask_only_if_missing": true,
      "ask_only_if_missing_note": "Before rendering, prefill trusted profile, activity history, route analysis and POI sources; ask only for values still missing and material to the selected analysis."
    }
  },
  "steps": [
    {
      "id": "step_mode",
      "order": 0,
      "title": {
        "pl": "Tryb wizarda",
        "en": "Wizard mode"
      },
      "description": {
        "pl": "Skrócony = mniej pytań, reszta wartości domyślnych. Zaawansowany = pełna kontrola nad danymi wejściowymi modeli.",
        "en": "Short = fewer questions, defaults for the rest. Advanced = full control over model inputs."
      }
    },
    {
      "id": "step_profile",
      "order": 1,
      "title": {
        "pl": "Profil i doświadczenie",
        "en": "Profile and experience"
      },
      "description": {
        "pl": "Wybierz rodzaj wyprawy i liczbę dni. Dane o doświadczeniu pobierzemy z profilu, jeśli są dostępne.",
        "en": "Your rider profile for this trip."
      }
    },
    {
      "id": "step_route",
      "order": 2,
      "title": {
        "pl": "Trasa i etap",
        "en": "Route and stage"
      },
      "description": {
        "pl": "Dystans, przewyższenie i nawierzchnię pobierzemy z trasy. Pytamy tylko o brakujące informacje.",
        "en": "From GPX or manual entry."
      }
    },
    {
      "id": "step_hydration",
      "order": 3,
      "title": {
        "pl": "Woda i hydratacja",
        "en": "Water and hydration"
      },
      "description": {
        "pl": "Jeśli profil nie zawiera pojemności bidonów lub bukłaka, możesz ją podać. Nie pytamy o współczynnik potliwości.",
        "en": "Carry capacity and optional sweat rate."
      }
    },
    {
      "id": "step_nutrition",
      "order": 4,
      "title": {
        "pl": "Żywienie na rowerze",
        "en": "On-bike nutrition"
      },
      "description": {
        "pl": "Preferencje i dokładny zapas jedzenia są opcjonalne. Bez listy produktów przygotujemy orientacyjny plan.",
        "en": "Preferences, gel CHO, planned pack."
      }
    },
    {
      "id": "step_equipment_logistics",
      "order": 5,
      "title": {
        "pl": "Sprzęt i logistyka",
        "en": "Equipment and logistics"
      },
      "description": {
        "pl": "Dodatkowe informacje o bagażu, samowystarczalności i sprzęcie — tylko jeśli chcesz je uzupełnić.",
        "en": "Luggage, bike, on-route POIs."
      }
    },
    {
      "id": "step_event",
      "order": 6,
      "title": {
        "pl": "Event / limit czasu (opcjonalnie)",
        "en": "Event / time limit (optional)"
      },
      "description": {
        "pl": "Brevet, ultramaraton, limit organizatora.",
        "en": "Brevet, ultra, organizer cutoff."
      }
    }
  ],
  "questions": [
    {
      "id": "q_wizard_mode",
      "step": "step_mode",
      "order": 1,
      "path": "wizard.mode",
      "type": "single_choice",
      "required": false,
      "label": {
        "pl": "Jak chcesz przejść konfigurację?",
        "en": "How do you want to configure the trip?"
      },
      "help": {
        "pl": "Domyślnie wybieramy krótką konfigurację. Tryb zaawansowany pokazuje dodatkowe pytania organizacyjne — nie wymaga znajomości parametrów fizjologicznych.",
        "en": "Short setup is selected by default. Advanced mode reveals extra planning questions, not specialist physiology metrics."
      },
      "options": [
        {
          "value": "short",
          "label": {
            "pl": "Skrócona — szybko, z domyślnymi założeniami",
            "en": "Short — fast, with defaults"
          },
          "description": {
            "pl": "Pytamy o typ wyprawy, dystans, przewyższenie, prędkość, wodę na start, preferencję jedzenia i ile żeli bierzesz. Reszta z defaults.",
            "en": "We ask trip type, distance, elevation, speed, start water, food preference and gel count. Rest from defaults."
          }
        },
        {
          "value": "advanced",
          "label": {
            "pl": "Zaawansowana — pełne pytania",
            "en": "Advanced — full questionnaire"
          },
          "description": {
            "pl": "Wszystkie kroki: pot, g CHO w żelu, POI, bagaż, limit czasu, GI itd.",
            "en": "All steps: sweat rate, gel CHO grams, POIs, luggage, time limit, GI, etc."
          }
        }
      ],
      "default": "short"
    },
    {
      "id": "q_profile_type",
      "step": "step_profile",
      "order": 10,
      "path": "profile.type",
      "type": "single_choice",
      "required": true,
      "label": {
        "pl": "Jaki to rodzaj wyprawy?",
        "en": "What kind of trip is this?"
      },
      "options": [
        {
          "value": "bikepacking",
          "label": {
            "pl": "Bikepacking / touring",
            "en": "Bikepacking / touring"
          }
        },
        {
          "value": "ultra",
          "label": {
            "pl": "Ultra / self-supported race",
            "en": "Ultra / self-supported race"
          }
        },
        {
          "value": "brevet",
          "label": {
            "pl": "Brevet / randonneuring",
            "en": "Brevet / randonneuring"
          }
        },
        {
          "value": "road",
          "label": {
            "pl": "Jednodniowa szosa / trening",
            "en": "Single-day road / training"
          }
        },
        {
          "value": "exploratory",
          "label": {
            "pl": "Eksploracyjna / niepewna logistyka",
            "en": "Exploratory / uncertain logistics"
          }
        }
      ],
      "modes": [
        "short",
        "advanced"
      ],
      "help": {
        "pl": "Wybierz cel wyprawy. Silnik dobierze odpowiednie analizy, ale nie wyłączy pozostałych ekspertów.",
        "en": "Choose the trip purpose. The engine prioritizes relevant analyses without disabling other experts."
      }
    },
    {
      "id": "q_experience_level",
      "step": "step_profile",
      "order": 20,
      "path": "user.experience_level",
      "type": "single_choice",
      "required": false,
      "label": {
        "pl": "Poziom doświadczenia kolarskiego?",
        "en": "Cycling experience level?"
      },
      "options": [
        {
          "value": "beginner",
          "label": {
            "pl": "Początkujący",
            "en": "Beginner"
          }
        },
        {
          "value": "intermediate",
          "label": {
            "pl": "Średniozaawansowany",
            "en": "Intermediate"
          }
        },
        {
          "value": "advanced",
          "label": {
            "pl": "Zaawansowany",
            "en": "Advanced"
          }
        },
        {
          "value": "elite",
          "label": {
            "pl": "Elita / zawodowiec",
            "en": "Elite"
          }
        }
      ],
      "modes": [
        "short",
        "advanced"
      ],
      "required_when_missing": true,
      "ask_if_missing": true,
      "prefill_from": "rider_profile.declared.experience_level",
      "help": {
        "pl": "Jeśli masz już profil Ridemore, ta odpowiedź zostanie pobrana automatycznie. Pytamy tylko wtedy, gdy brakuje tej informacji.",
        "en": "If your Ridemore profile already contains this information, it is filled automatically."
      }
    },
    {
      "id": "q_multi_day_experience",
      "step": "step_profile",
      "order": 30,
      "path": "user.multi_day_experience",
      "type": "single_choice",
      "required": false,
      "label": {
        "pl": "Czy jechałeś już multi-day (kilka dni z rzędu)?",
        "en": "Have you done multi-day riding before?"
      },
      "options": [
        {
          "value": false,
          "label": {
            "pl": "Nie, pierwszy raz",
            "en": "No, first time"
          }
        },
        {
          "value": "limited",
          "label": {
            "pl": "Tak, ale mało / dawno",
            "en": "Yes, but limited"
          }
        },
        {
          "value": true,
          "label": {
            "pl": "Tak, regularnie",
            "en": "Yes, regularly"
          }
        }
      ],
      "modes": [
        "advanced"
      ],
      "ask_if_missing": true,
      "prefill_from": "rider_profile.declared.multi_day_experience"
    },
    {
      "id": "q_bikepacking_experience",
      "step": "step_profile",
      "order": 40,
      "path": "user.bikepacking_experience",
      "type": "boolean",
      "required": false,
      "label": {
        "pl": "Czy masz doświadczenie w bikepackingu (bagaż na rowerze, noclegi w trasie)?",
        "en": "Bikepacking experience?"
      },
      "show_if": {
        "and": [
          {
            "path": "wizard.mode",
            "eq": "advanced"
          },
          {
            "path": "profile.type",
            "in": [
              "bikepacking",
              "exploratory",
              "ultra"
            ]
          }
        ]
      },
      "modes": [
        "advanced"
      ],
      "ask_if_missing": true,
      "prefill_from": "rider_profile.declared.bikepacking_experience"
    },
    {
